<% layout("/layouts/boilerplate") %>

<div class="container d-flex justify-content-center align-items-center signup-container">

    <div class="signup-card">

        <div class="text-center mb-4">
            <div class="signup-icon">
                <i class="fa-solid fa-right-to-bracket"></i>
            </div>
            <h2 class="fw-bold mt-3">Welcome Back</h2>
            <p class="text-muted">Login to continue with Perch.</p>
        </div>

        <% if (typeof error !== "undefined" && error && error.length) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <% if (typeof success !== "undefined" && success && success.length) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <form action="/login" method="POST" class="needs-validation" novalidate>

            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" id="username" name="username"
                       placeholder="Enter username" required>
                <div class="invalid-feedback">Please enter your username.</div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <div class="input-group">
                    <input type="password" class="form-control" id="password" name="password"
                           placeholder="Enter password" required>
                    <button class="btn btn-outline-secondary" type="button" id="togglePasswordLogin">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <div class="invalid-feedback">Password is required.</div>
            </div>

            <button class="btn signup-btn w-100">Login</button>

        </form>

        <hr>

        <p class="text-center mb-0">
            New to Perch? <a href="/signUp" class="login-link">Create an account</a>
        </p>

    </div>

</div>

<script>
const togglePasswordLogin = document.querySelector("#togglePasswordLogin");
const passwordLogin = document.querySelector("#password");

togglePasswordLogin.addEventListener("click", function () {
    const type = passwordLogin.getAttribute("type") === "password" ? "text" : "password";
    passwordLogin.setAttribute("type", type);
    this.innerHTML = type === "password"
        ? '<i class="fa-solid fa-eye"></i>'
        : '<i class="fa-solid fa-eye-slash"></i>';
});
</script>