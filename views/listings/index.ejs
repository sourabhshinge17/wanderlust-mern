<% layout("/layouts/boilerplate") %> 
<div class="desktop-only">
    <%- include("../includes/hero") %>
</div>


<% const cat = typeof activeCategory !== 'undefined' ? activeCategory : 'Trending'; %>

<div class="filters-wrapper">

  <div id="filters">
    <a href="/listings" class="filter <%= cat === 'Trending' ? 'active' : '' %>">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms" class="filter <%= cat === 'Rooms' ? 'active' : '' %>">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </a>

    <a href="/listings?category=Iconic Cities" class="filter <%= cat === 'Iconic Cities' ? 'active' : '' %>">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=Mountains" class="filter <%= cat === 'Mountains' ? 'active' : '' %>">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </a>

    <a href="/listings?category=Castles" class="filter <%= cat === 'Castles' ? 'active' : '' %>">
      <div><i class="fa-solid fa-chess-rook"></i></div>
      <p>Castles</p>
    </a>

    <a href="/listings?category=Amazing Pools" class="filter <%= cat === 'Amazing Pools' ? 'active' : '' %>">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing Pools</p>
    </a>

    <a href="/listings?category=Camping" class="filter <%= cat === 'Camping' ? 'active' : '' %>">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </a>

    <a href="/listings?category=Farms" class="filter <%= cat === 'Farms' ? 'active' : '' %>">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
    </a>

    <a href="/listings?category=Arctic" class="filter <%= cat === 'Arctic' ? 'active' : '' %>">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </a>

    <a href="/listings?category=Beachfront" class="filter <%= cat === 'Beachfront' ? 'active' : '' %>">
      <div><i class="fa-solid fa-umbrella-beach"></i></div>
      <p>Beachfront</p>
    </a>

    <a href="/listings?category=Countryside" class="filter <%= cat === 'Countryside' ? 'active' : '' %>">
      <div><i class="fa-solid fa-wheat-awn"></i></div>
      <p>Countryside</p>
    </a>
  </div>

  <div class="tax-switch">
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
      <label class="form-check-label ms-2" for="flexSwitchCheckDefault">
        Display total after taxes
      </label>
    </div>
  </div>

</div>

<% if (allListings.length === 0) { %>
  <p class="no-listings">No listings found.</p>
<% } else { %>
  <div class="listing-grid">
    <% for (let listing of allListings) { %>
      <%- include('../includes/listingCard', { listing }) %>
    <% } %>
  </div>
<% } %>
<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxinfo = document.getElementsByClassName("tax-info");
    for(info of taxinfo) {
      if(info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }

  })
</script>