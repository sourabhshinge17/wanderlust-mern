<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <h2>
<%= listing.title %>
<span class="show-rating badge bg-dark ms-2" style="font-size: 0.85rem; vertical-align: middle;">
<% if(listing.avgRating){ %>
⭐ <%= listing.avgRating.toFixed(1) %>
<% } else { %>
★ New
<% } %>
</span>
</h2>

    <div class="card col-8 offset-2 shadow-sm">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            alt="<%= listing.title %>"
            style="height:400px; object-fit:cover;"
        >

        <div class="card-body">

            <p class="card-text">
                <i>Owned by <%= listing.owner ? listing.owner.username : "Unknown Host" %></i>
         
            </p>
            <p class="card-text">
                 
                <%= listing.description %>
            </p>
  
            <hr>

            <p>
                <strong>Price:</strong>
                ₹<%= listing.price.toLocaleString("en-IN") %> / night
            </p>

            <p>
                <strong>Location:</strong>
                <%= listing.location %>
            </p>

            <p>
                <strong>Country:</strong>
                <%= listing.country %>
            </p>

            <!-- MAP START -->
            <p><strong>Where you'll be:</strong></p>
            <div id="map" style="height: 300px; border-radius: 8px;"></div>
            <!-- MAP END -->

          <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
            <div class="mt-4 d-flex gap-2">

                
                    <a href="/listings/<%= listing._id %>/edit"
                    class="btn btn-dark"
                >
                    Edit Listing
                </a>

                <form
                    action="/listings/<%= listing._id %>?_method=DELETE"
                    method="POST"
                >
                    <button
                        class="btn btn-danger"
                    >
                        Delete Listing
                    </button>
                </form>

            </div>
            <% } %>

            <div class="mt-3">
                <a href="/listings" class="btn btn-outline-secondary">
                    ← Back to Listings
                </a>
            </div>

        </div>

    </div>
    <hr>

<div class="col-8 offset-2">

    <% if(currUser) { %>

    <h4 class="mb-3">Leave a Review</h4>

    <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
    >

        <!-- Star Rating -->
        <fieldset class="starability-slot mb-4">

            <legend>Rating</legend>

            <input
                type="radio"
                id="no-rate"
                class="input-no-rate"
                name="review[rating]"
                value="0"
                checked
                aria-label="No rating."
            />

            <input
                type="radio"
                id="first-rate1"
                name="review[rating]"
                value="1"
            />
            <label for="first-rate1" title="Terrible">1 star</label>

            <input
                type="radio"
                id="first-rate2"
                name="review[rating]"
                value="2"
            />
            <label for="first-rate2" title="Not good">2 stars</label>

            <input
                type="radio"
                id="first-rate3"
                name="review[rating]"
                value="3"
            />
            <label for="first-rate3" title="Average">3 stars</label>

            <input
                type="radio"
                id="first-rate4"
                name="review[rating]"
                value="4"
            />
            <label for="first-rate4" title="Very good">4 stars</label>

            <input
                type="radio"
                id="first-rate5"
                name="review[rating]"
                value="5"
            />
            <label for="first-rate5" title="Amazing">5 stars</label>

        </fieldset>

        <!-- Comment -->
        <div class="mb-3">

            <label for="comment" class="form-label">
                Comments
            </label>

            <textarea
                id="comment"
                name="review[comment]"
                rows="4"
                class="form-control"
                placeholder="Write your review here..."
                required
            ></textarea>

            <div class="invalid-feedback">
                Please add a review.
            </div>

        </div>

        <button class="btn btn-dark">
            Submit Review
        </button>

    </form>

    <% } %>

</div>

<hr class="my-5">

<div class="col-lg-8 offset-lg-2">

    <h3 class="fw-bold mb-4">★ Guest Reviews</h3>

    <% if(listing.reviews.length > 0){ %>

        <div class="row g-4">

        <% for(let review of listing.reviews){ %>

            <div class="col-md-6">

                <div class="review-card">

                    <div class="review-header">

                        <div class="d-flex align-items-center">

                            <img
                                src="https://i.pravatar.cc/60?img=<%= Math.floor(Math.random()*70) %>"
                                class="review-avatar"
                            >

                            <div class="ms-3">

                                <h6 class="mb-0 fw-bold">
                                    @<%= review.author.username %>
                                </h6>

                                <small class="text-muted">
                                    <%= new Date(review.createdAt).toDateString() %>
                                </small>

                            </div>

                        </div>

                    </div>

                    <div class="stars mt-3">

                        <% for(let i=1;i<=5;i++){ %>

                            <% if(i<=review.rating){ %>

                                <i class="fa-solid fa-star text-warning"></i>

                            <% } else { %>

                                <i class="fa-regular fa-star text-warning"></i>

                            <% } %>

                        <% } %>

                    </div>

                    <p class="mt-3 review-comment">
                        <%= review.comment %>
                    </p>

                    <hr>

                    <div class="review-footer d-flex justify-content-between">

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-dark"
                        >
                            ❤️ Helpful
                        </button>

                        <form
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                            method="POST"
                        >

                            <button
                                class="btn btn-sm btn-outline-danger"
                            >
                                🗑 Delete
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        <% } %>

        </div>

    <% } else { %>

        <p class="text-muted">
            No reviews yet.
        </p>

    <% } %>

</div>
</div>
</div>

</div>

<!-- MAP SCRIPT START -->
<script>
  const map = L.map('map').setView([<%= listing.lat || 0 %>, <%= listing.lng || 0 %>], 13);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);
  L.marker([<%= listing.lat || 0 %>, <%= listing.lng || 0 %>]).addTo(map)
    .bindPopup("<%= listing.location %>");
</script>
<!-- MAP SCRIPT END -->